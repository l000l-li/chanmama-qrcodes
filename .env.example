# 复制为 .env 后填入真实值

# 路径（相对路径按项目目录解析）
CHANMAMA_COOKIE_PATH=chanmama_raw.json
EXCEL_PATH=禅妈妈商品链接记录表.xlsx
LOG_DIR=logs

# GitHub 图床（Personal Access Token 需具备 repo 写权限）
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main

# WPS AirScript：Token 与阶段 A / 阶段 B / 读链接 三个 webhook
AIRSCRIPT_TOKEN=
AIRSCRIPT_WEBHOOK_A=
AIRSCRIPT_WEBHOOK_B=
AIRSCRIPT_WEBHOOK_LINKS=

# 浏览器：HEADLESS=1 时无窗口运行（可能更容易触发风控）
HEADLESS=0
SLOW_MO=100
